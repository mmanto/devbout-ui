{
  "name": "devbout-ui",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "data-table"
  ],
  "scripts": {
    "build": "npm run build --workspace @mmanto/devbout-ui",
    "typecheck": "npm run typecheck --workspace @mmanto/devbout-ui",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "node -e \"console.error('\\n✋ La raíz de devbout-ui es un workspace privado: no se publica.\\n   El paquete vive en data-table/. Usá:\\n     cd data-table && npm publish   (o desde la raíz: npm run release)\\n'); process.exit(1)\"",
    "lint": "eslint data-table/src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
