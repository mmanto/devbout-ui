{
  "name": "@mmanto/devbout-ui",
  "version": "0.2.0",
  "description": "Primitivas base-mira (shadcn) y data-table declarativo: tabla, filtros, selección, acciones por fila, alta/edición/detalle por DTO.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "tailwind.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmanto/devbout-ui.git"
  },
  "keywords": [
    "react",
    "tailwind",
    "shadcn",
    "data-table",
    "base-ui"
  ],
  "scripts": {
    "build": "tsup && node scripts/use-client.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-table": "^9.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
